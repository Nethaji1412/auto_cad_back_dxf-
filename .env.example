APP_NAME=Solar Layout Backend
APP_ENV=development
DEBUG=false

# MySQL connection string. In docker-compose this matches the `db` service.
DATABASE_URL=mysql+pymysql://solar_user:CHANGE_ME@localhost:3306/solar_layout

JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
MAX_UPLOAD_SIZE_MB=50

# Absolute path to ODA File Converter's .exe, only needed if you want real
# .dwg output (see existing_pipeline/dwg_export.py). Leave blank to skip DWG
# and only produce DXF.
ODA_FILE_CONVERTER_PATH=

# Comma-separated list. Never "*" in production.
CORS_ORIGINS=http://localhost:8501

REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_ENABLED=true
